      "friendNodes": [
        {
          "key": "rain_cup",
          "sourceNode": "rain_cup",
          "delay": 1,
          "primaryWhen": {
            "min": {
              "insight": 6
            }
          },
          "primaryText": "你认出漏水的瓦缝，递瓦片给灵梦补好。盆里不再滴水，她让你把湿纸移到廊内，两人一起摊平。",
          "primarySet": [
            "love:mended_eave"
          ],
          "fallbackText": "你没找准漏雨的地方，便扶稳木盆。灵梦把另一盆推到廊内，两人接住湿纸，等雨停后再查。",
          "fallbackSet": [],
          "trustBothBranches": 1,
          "next": "tea_kind"
        },
        {
          "key": "tea_kind",
          "sourceNode": "tea_kind",
          "delay": 2,
          "primaryWhen": {
            "min": {
              "bond": 6
            }
          },
          "primaryText": "灵梦在村里买茶，问你上回那杯是否太浓。你说喜欢淡些，她在纸包上画了记号，约好下次试试。",
          "primarySet": [
            "love:named_tea"
          ],
          "fallbackText": "灵梦买完茶叫住你，说祭纸又快用完。你问哪天能来帮忙，她约好时辰，也说忙完可以坐下喝一杯。",
          "fallbackSet": [],
          "trustBothBranches": 1,
          "next": "roof_check"
        },
        {
          "key": "roof_check",
          "sourceNode": "roof_check",
          "delay": 1,
          "primaryWhen": {
            "relationFlags": [
              "love:mended_eave"
            ]
          },
          "primaryText": "又到雨季，你站在廊下看补过的地方。灵梦指给你一处新湿痕，你们重新摆好盆，原先那一处倒真没漏。",
          "primarySet": [],
          "fallbackText": "你来帮灵梦把接雨盆挪回原处，忙到雨停。她数好最后几张干纸，你们把没湿的一叠留到下次祭日。",
          "fallbackSet": [],
          "trustBothBranches": 1,
          "next": "kept_cup"
        },
        {
          "key": "kept_cup",
          "sourceNode": "kept_cup",
          "delay": 2,
          "primaryWhen": {
            "relationFlags": [
              "love:named_tea"
            ]
          },
          "primaryText": "灵梦泡了你说过的淡茶，自己尝完直嫌没味。你笑着分她一块点心，她留下那只杯，说下回还用它。",
          "primarySet": [],
          "fallbackText": "祭纸收好，灵梦给你留一块坐垫。你们坐在廊下喝茶，约好下回来时各带一个近来的小故事。",
          "fallbackSet": [],
          "trustBothBranches": 1,
          "next": "young_shrine_answer"
        }
      ],
      "confession": {
        "key": "young_shrine_answer",
        "sourceConfession": "shrine_answer",
        "personMinAge": 16,
        "text": "灵梦把你常用的杯放好，说喜欢你，问以后能否做恋人。你认真答愿意；她笑着约下次一起喝茶，各自的功课也别耽误。",
        "waitText": "你们喝完廊下的茶，约好下回还来。灵梦把杯收好，今日的心事先留在朋友之间，往来照旧。",
        "declineText": "灵梦听完心意，说愿意继续做茶友。你应下，把杯放回原处，往后仍按约来帮祭纸的忙。",
